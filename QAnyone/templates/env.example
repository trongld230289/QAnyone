BASE_URL=https://app.example.com
AUTH_REQUIRED=false

# --- run flags (change any time; no code edit needed) ---
# Values are Playwright's own names. For TRACE / VIDEO / SCREENSHOT:
#   on                 record for every test, passed or failed (heavy; for demos / full review)
#   retain-on-failure  record every test, keep the file only when the test fails (default)
#   only-on-failure    same idea for SCREENSHOT — Playwright names it differently
#   off                record nothing

# true = run without a window; false = watch the browser while tests run
HEADLESS=true
# trace = step-by-step replay in the report: every action, DOM snapshot, network call
TRACE=retain-on-failure
# video of the browser screen — the heaviest of the three
VIDEO=retain-on-failure
# one image of the page at the end of the test
SCREENSHOT=only-on-failure

# --- only when the app needs login ---
LOGIN_USERNAME=
LOGIN_PASSWORD=
# --- only when 2FA = TOTP ---
TOTP_SECRET=
# --- only when test cases come from Azure DevOps ---
ADO_ORG=https://dev.azure.com/my-org
ADO_PROJECT=
ADO_PAT=
