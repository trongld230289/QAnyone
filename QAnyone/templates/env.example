BASE_URL=https://app.example.com
AUTH_REQUIRED=false

# --- run flags (change any time; no code edit needed) ---
HEADLESS=true                 # false = watch the browser while tests run
TRACE=retain-on-failure       # on | retain-on-failure | off   (step-by-step viewer in the report)
VIDEO=retain-on-failure       # on | retain-on-failure | off   (heaviest; "on" only for demos)
SCREENSHOT=only-on-failure    # on | only-on-failure | off     (one image per test in the report)

# --- only when the app needs login ---
LOGIN_USERNAME=
LOGIN_PASSWORD=
# --- only when 2FA = TOTP ---
TOTP_SECRET=
# --- only when test cases come from Azure DevOps ---
ADO_ORG=https://dev.azure.com/my-org
ADO_PROJECT=
ADO_PAT=
