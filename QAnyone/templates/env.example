BASE_URL=https://app.example.com
AUTH_REQUIRED=false

# --- run flags (change any time; no code edit needed) ---

# HEADLESS — is there a browser window while tests run?
#   false  a window you can watch, maximised with VIEWPORT=max (default)
#   true   no window, fastest (what CI uses; also the default when the CI variable is set)
HEADLESS=false

# TRACE — step-by-step replay in the HTML report: every action, DOM snapshot, network call
#   retain-on-failure  record every test, keep the file only when the test fails (default)
#   on                 keep it for every test, passed or failed (heavy; demos / full review)
#   on-first-retry     record only when a test is retried
#   off                never
TRACE=retain-on-failure

# VIDEO — a video of the browser screen, the heaviest of the three
#   retain-on-failure  keep only for failed tests (default)
#   on                 keep for every test
#   off                never
VIDEO=retain-on-failure

# SCREENSHOT — one image of the page at the end of each test
#   only-on-failure    only for failed tests (default)
#   on                 for every test
#   off                never
SCREENSHOT=only-on-failure

# VIEWPORT — size of the page area
#   max                window maximised, page fills it (default; needs HEADLESS=false, Chromium —
#                      headless has no window and uses 1280x720 instead)
#   <width>x<height>   fixed size, e.g. 1920x1080, 1366x768, or 390x844 for a phone-like layout
VIEWPORT=max

# --- only when the app needs login ---
LOGIN_USERNAME=
LOGIN_PASSWORD=
# --- only when 2FA = TOTP: the base32 key shown by the authenticator app at enrolment
# ("Can't scan the QR code?"), spaces allowed ---
TOTP_SECRET=
# --- only when test cases come from Azure DevOps ---
ADO_ORG=https://dev.azure.com/my-org
ADO_PROJECT=
ADO_PAT=
