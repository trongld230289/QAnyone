{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm init:*)",
      "Bash(npm i:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npx playwright:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsx:*)",
      "Bash(node:*)",
      "mcp__playwright__*"
    ],
    "deny": [
      "Read(.env)",
      "Read(playwright/.auth/**)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["playwright"]
}
